{
  "info": {
    "name": "Colégio Sanquim - API REST",
    "description": "Collection revisada para o MVP. Ordem recomendada: 0 Auth, 1 Admin, 2 Diário, 3 Aluno, 4 Segurança. Use as variáveis da collection para baseUrl e credenciais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "emailGestao", "value": "admin@sanquim.br" },
    { "key": "senhaGestao", "value": "123456" },
    { "key": "emailProfessor", "value": "prof.mat@sanquim.br" },
    { "key": "senhaProfessor", "value": "123456" },
    { "key": "emailAluno", "value": "aluno1@sanquim.br" },
    { "key": "senhaAluno", "value": "123456" },
    { "key": "tokenGestao", "value": "" },
    { "key": "tokenProfessor", "value": "" },
    { "key": "tokenAluno", "value": "" },
    { "key": "professorId", "value": "1" },
    { "key": "alunoId", "value": "1" },
    { "key": "turmaId", "value": "1" },
    { "key": "disciplinaId", "value": "1" },
    { "key": "avaliacaoId", "value": "1" },
    { "key": "turmaDisciplinaId", "value": "1" }
  ],
  "item": [
    {
      "name": "0 - Auth",
      "item": [
        {
          "name": "Login Gestão",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('tokenGestao', j.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{emailGestao}}\",\n  \"senha\": \"{{senhaGestao}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Professor",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('tokenProfessor', j.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{emailProfessor}}\",\n  \"senha\": \"{{senhaProfessor}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Aluno",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('tokenAluno', j.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{emailAluno}}\",\n  \"senha\": \"{{senhaAluno}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login com senha errada (espera 401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{emailGestao}}\",\n  \"senha\": \"senha-errada\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "1 - Admin (ROLE_GESTAO)",
      "item": [
        {
          "name": "Cadastrar professor",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "if (j.id) pm.collectionVariables.set('professorId', j.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Professor Teste\",\n  \"email\": \"prof.{{$timestamp}}@sanquim.br\",\n  \"senha\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/professores", "host": ["{{baseUrl}}"], "path": ["api", "admin", "professores"] }
          }
        },
        {
          "name": "Listar professores",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/professores", "host": ["{{baseUrl}}"], "path": ["api", "admin", "professores"] }
          }
        },
        {
          "name": "Cadastrar aluno",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "if (j.id) pm.collectionVariables.set('alunoId', j.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Aluno Teste\",\n  \"email\": \"aluno.{{$timestamp}}@sanquim.br\",\n  \"senha\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/alunos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "alunos"] }
          }
        },
        {
          "name": "Listar alunos",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/alunos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "alunos"] }
          }
        },
        {
          "name": "Criar turma",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "if (j.id) pm.collectionVariables.set('turmaId', j.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"identificacao\": \"C\",\n  \"serie\": \"1º Ano\",\n  \"anoLetivo\": 2026,\n  \"status\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/turmas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "turmas"] }
          }
        },
        {
          "name": "Criar disciplina",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "if (j.id) pm.collectionVariables.set('disciplinaId', j.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Física {{$timestamp}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/disciplinas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "disciplinas"] }
          }
        },
        {
          "name": "Matricular aluno na turma",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"alunoId\": {{alunoId}},\n  \"turmaId\": {{turmaId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/matriculas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "matriculas"] }
          }
        },
        {
          "name": "Cadastro inválido (espera 400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenGestao}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"\",\n  \"email\": \"email-invalido\",\n  \"senha\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/alunos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "alunos"] }
          }
        }
      ]
    },
    {
      "name": "2 - Diário (ROLE_PROFESSOR)",
      "item": [
        {
          "name": "Minhas turmas",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "if (j.length > 0) pm.collectionVariables.set('turmaDisciplinaId', j[0].id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProfessor}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/diario/minhas-turmas", "host": ["{{baseUrl}}"], "path": ["api", "diario", "minhas-turmas"] }
          }
        },
        {
          "name": "Registrar chamada em lote",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Chamada registrada (201)', () => pm.response.to.have.status(201));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProfessor}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"turmaId\": {{turmaId}},\n  \"disciplinaId\": {{disciplinaId}},\n  \"dataAula\": \"2026-11-24\",\n  \"registros\": [\n    { \"alunoId\": {{alunoId}}, \"presente\": true }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/diario/chamada", "host": ["{{baseUrl}}"], "path": ["api", "diario", "chamada"] }
          }
        },
        {
          "name": "Criar avaliação",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "if (j.id) pm.collectionVariables.set('avaliacaoId', j.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProfessor}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Prova Mensal\",\n  \"tipo\": \"PROVA\",\n  \"notaMaxima\": 10.0,\n  \"peso\": 1.0,\n  \"dataEntrega\": \"2026-12-01\",\n  \"turmaDisciplinaID\": {{turmaDisciplinaId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/diario/avaliacoes", "host": ["{{baseUrl}}"], "path": ["api", "diario", "avaliacoes"] }
          }
        },
        {
          "name": "Lançar notas",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Notas lançadas (201)', () => pm.response.to.have.status(201));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProfessor}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"valor\": 8.5,\n  \"avaliacaoID\": {{avaliacaoId}},\n  \"alunoID\": {{alunoId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/diario/avaliacoes/{{avaliacaoId}}/notas", "host": ["{{baseUrl}}"], "path": ["api", "diario", "avaliacoes", "{{avaliacaoId}}", "notas"] }
          }
        },
        {
          "name": "Registrar plano de aula",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProfessor}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"data\": \"2026-11-24\",\n  \"descricao\": \"Aula sobre polinômios\",\n  \"topicos\": \"Definição, Grau, Operações\",\n  \"turmaDisciplinaID\": {{turmaDisciplinaId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/diario/planos-aula", "host": ["{{baseUrl}}"], "path": ["api", "diario", "planos-aula"] }
          }
        }
      ]
    },
    {
